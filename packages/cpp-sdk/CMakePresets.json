            "generator": "Unix Makefiles",
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "xcode-release",
            "inherits": "base-release",
            "displayName": "Release Xcode (macOS)",
            "generator": "Xcode",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "ninja-release",
            "inherits": "base-ninja-release",
            "displayName": "Release Ninja (cross-platform)"
        },
        {
            "name": "windows-release",
            "inherits": "base-release",

{
    "tasks": [
        {
            "type": "shell",
            "label": "CMake: Build active test",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--target",
                "${fileBasenameNoExtension}",
                "--config",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc",
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build the current test target using CMake"
        },
        {
            "type": "shell",
            "label": "CMake: Configure",
            "command": "node",
            "args": [
                "-e",
                "var p=process.platform==='win32'?'windows':'unix';require('child_process').execSync('cmake --preset '+p,{stdio:'inherit'})"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Configure CMake build system using presets"
        },
        {
            "type": "shell",
            "label": "CMake: Build all tests",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "--config",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc",
                "$msCompile"
            ],
            "group": "build",
            "detail": "Build all test executables using CMake"
        }
    ],
    "version": "2.0.0"
}
